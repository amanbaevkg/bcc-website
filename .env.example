# Local development: copy to apps/web/.env.local (pnpm dev) or to .env in the repository root
# (docker compose up). Never commit real values.
# On Vercel / Netlify / the Node server, set these in the host's environment settings.

# ── Site ────────────────────────────────────────────────────────────────
# development | staging | production. Anything but "production" sends noindex.
SITE_ENV=development
# Public base URL, used for canonical links, sitemap and Open Graph.
SITE_URL=http://localhost:3000
# Staging only: "user:password" puts the whole site behind a login. Leave empty in production.
SITE_BASIC_AUTH=

# ── Contact form e-mail (phase 3) ───────────────────────────────────────
# log | smtp | resend | postmark. "log" writes messages to the server log and sends nothing.
EMAIL_PROVIDER=log
# Recipient (confirmed by BCC) and sender address (an SMTP account from Cloud Power, e.g. website@bcc-lux.eu).
CONTACT_TO=info@bcc-lux.eu
CONTACT_FROM=
# SMTP (corporate mail server)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Resend
RESEND_API_KEY=
# Postmark
POSTMARK_SERVER_TOKEN=

# ── Spam protection and rate limiting (phase 3) ─────────────────────────
# Cloudflare Turnstile. The site key is public; the secret key is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Contact messages allowed per visitor per 10 minutes.
CONTACT_RATE_LIMIT=5
# Upstash Redis for rate limiting across serverless instances. Empty = in-memory (single server only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Test only: show labelled example news to review the News pages (ignored when SITE_ENV=production).
NEWS_FIXTURES=

# ── Admin (Payload CMS at /admin) ───────────────────────────────────────
# Signs sign-in sessions. 32+ random characters (e.g. `openssl rand -hex 32`). Secret.
PAYLOAD_SECRET=
# The database file and the uploads folder. On the server, keep both on a persistent volume and back them up.
DATABASE_URL=file:./data/payload.db
PAYLOAD_MEDIA_DIR=
# Read only on the very first start, to create the first administrator. Secret; remove after first start.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
# On the first start the current website texts and photos are imported into the admin. false = skip.
PAYLOAD_SEED=
