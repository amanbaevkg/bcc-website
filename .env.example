# Copy to apps/web/.env.local for local development. Never commit real values.
# On Vercel / Netlify / the Node server, set these in the host's environment settings.

# ── Site ────────────────────────────────────────────────────────────────
# development | staging | production. Anything but "production" sends noindex.
SITE_ENV=development
# Public base URL, used for canonical links, sitemap and Open Graph.
SITE_URL=http://localhost:3000
# Staging only: "user:password" puts the whole site behind a login. Leave empty in production.
SITE_BASIC_AUTH=

# ── Contact form e-mail (phase 3) ───────────────────────────────────────
# log | smtp | resend | postmark. "log" writes messages to the server log and sends nothing.
EMAIL_PROVIDER=log
# Recipient (to be confirmed by BCC) and sender address.
CONTACT_TO=
CONTACT_FROM=
# SMTP (corporate mail server)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Resend
RESEND_API_KEY=
# Postmark
POSTMARK_SERVER_TOKEN=

# ── Spam protection and rate limiting (phase 3) ─────────────────────────
# Cloudflare Turnstile. The site key is public; the secret key is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis for rate limiting across serverless instances. Empty = in-memory (single server only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sanity CMS (phase 2) ────────────────────────────────────────────────
# Project ID and dataset are public identifiers. Empty = built-in fallback content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Read token: only for draft preview. Viewer role, never an editor/admin token.
SANITY_API_READ_TOKEN=
